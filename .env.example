# Copy this file to .env and fill in the values. Never commit .env.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string. Required in production, e.g.
#   postgresql://user:password@host/dbname?sslmode=require
# Leave empty for local development: an embedded database in ./data/pglite is used instead.
DATABASE_URL=

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the server (usually 1 on a hosting platform, 0 locally)
TRUST_PROXY=0

# Admin sessions: minutes of inactivity before sign-out, and the maximum session length in hours
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_SESSION_MAX_HOURS=12

# LEGACY shared key for scripts that call the admin API with "Authorization: Bearer …".
# Administrators sign in with their own accounts (see README, "Administrators").
# Leave empty to switch this path off.
ADMIN_API_KEY=

# Google Sheets (optional — leave all three empty to skip the sheet)
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Tab to write to. Leave empty to use the first tab of the spreadsheet.
GOOGLE_SHEETS_TAB=

# WhatsApp number for enquiry links: digits only, with country code
WHATSAPP_NUMBER=917385087502
