# Copy this file to .env and fill in the values. Never commit .env.

NODE_ENV=development
PORT=4000

# SQLite database file (created automatically on first start)
DATABASE_URL=file:./data/parijatk.db

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the server (usually 1 on a hosting platform, 0 locally)
TRUST_PROXY=0

# Secret for the admin endpoints (GET/PATCH /api/enquiries). At least 24 characters.
# Leave empty to keep those endpoints disabled.
ADMIN_API_KEY=

# Google Sheets (optional — leave all three empty to skip the sheet)
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Where rows are appended: A1 = first tab, or e.g. Enquiries!A1 for a named tab
GOOGLE_SHEETS_RANGE=A1

# WhatsApp number for enquiry links: digits only, with country code
WHATSAPP_NUMBER=917385087502
